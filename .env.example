# Origin of the Go API (qrcode_generator_backend). Inlined into the browser bundle at build time.
# The API must list this site's origin in CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Public origin of this site (canonical URLs, sitemap, robots.txt). The API's APP_BASE_URL
# points here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile site key for sign-up, resend and forgot-password. Required for production
# builds; leave empty locally (the forms skip the check, and a local API without a Turnstile secret
# ignores it). Cloudflare's always-pass test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Shows "Continue with Google" on login and sign-up. Set true only when the API has
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (its Google endpoints answer 404 otherwise).
NEXT_PUBLIC_GOOGLE_LOGIN=false
