# Origin of the Go API (qrcode_generator_backend). Inlined into the browser bundle at build time.
# The API must list this site's origin in CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Public origin of this site (canonical URLs, sitemap, robots.txt). The API's APP_BASE_URL
# points here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
